# Required for AI features
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# Required for production deployments
SECRET_KEY=replace_with_a_long_random_secret
FLASK_ENV=development
FLASK_DEBUG=false

# Comma-separated list of allowed browser origins, for example:
# CORS_ORIGINS=https://reviewmaestro.example.com,https://www.reviewmaestro.example.com
CORS_ORIGINS=

# Optional. Defaults to local SQLite at src/database/app.db when omitted.
DATABASE_URL=
